# Copy this file to .env and fill in real values. .env is gitignored - never commit real
# credentials. See db/create_user.sql / db/provision_user.sh for what these accounts can do.

DDOCRAFT_DB_HOST=
DDOCRAFT_DB_PORT=3306
DDOCRAFT_DB_NAME=ddocraft

DDOCRAFT_SERVER_PORT=3001

DDOCRAFT_ADMIN_USER=ddocraft_admin
DDOCRAFT_ADMIN_PASSWORD=

DDOCRAFT_WEB_USER=ddocraft_web
DDOCRAFT_WEB_PASSWORD=
